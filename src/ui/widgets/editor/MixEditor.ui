  <property name="windowTitle">
   <string>NaxStudio Flow - Editor de Mixagem</string>
  </property>
  <property name="styleSheet">
   <string notr="true">#MixEditor, #scrollArea, #scrollAreaWidgetContents {
	background-color: #191D24;
	color: #FFFFFF;
	border: none;
}

QLabel {
	color: #FFFFFF;
}

#labelDuration, #labelPosition, #labelSectionLeft, #labelSectionRight {
	color: #8E9EB5;
	font-weight: bold;
}

#waveformCard, #col1, #col2 {
	background-color: #1F232C;
	border: 1px solid #2D3340;
	border-radius: 10px;
}

QPushButton {
	background-color: #2D3340;
	color: #FFFFFF;
	border: none;
	border-radius: 7px;
	padding: 6px 12px;
	font-weight: bold;
}

QPushButton:hover {
	background-color: #3E4A5E;
}

QPushButton:disabled {
	background-color: #242934;
	color: #8E9EB5;
}

#btnSave {
	background-color: #FFA60A;
	color: #000000;
}

#btnSave:hover {
	background-color: #CA8102;
}

#btnSave:disabled {
	background-color: #3B3222;
	color: #8E9EB5;
}

QTimeEdit {
	background-color: #2D3340;
	color: #FFFFFF;
	border: 1px solid #3E4A5E;
	border-radius: 7px;
	padding: 5px 24px 5px 8px;
}

QTimeEdit:focus {
	border: 1px solid #FFA60A;
}

QTimeEdit::up-button, QTimeEdit::down-button {
	subcontrol-origin: border;
	width: 20px;
	border: none;
	background-color: transparent;
}

QTimeEdit::up-button {
	subcontrol-position: top right;
	border-top-right-radius: 7px;
}

QTimeEdit::down-button {
	subcontrol-position: bottom right;
	border-bottom-right-radius: 7px;
}

QTimeEdit::up-button:hover, QTimeEdit::down-button:hover {
	background-color: #1F232C;
}

QTimeEdit::up-arrow {
	image: url(":/images/icons/arrow-up.svg");
	width: 8px;
	height: 8px;
}

QTimeEdit::down-arrow {
	image: url(":/images/icons/arrow-down.svg");
	width: 8px;
	height: 8px;
}

QSlider::groove:horizontal {
	background: #191D24;
	height: 8px;
	border-radius: 4px;
}

QSlider::sub-page:horizontal {
	background: #FFA60A;
	height: 8px;
	border-radius: 4px;
}

QSlider::add-page:horizontal {
	background: #191D24;
	height: 8px;
	border-radius: 4px;
}

QSlider::handle:horizontal {
	background: #FFFFFF;
	border: 2px solid #FFA60A;
	width: 12px;
	height: 12px;
	margin: -4px 0;
	border-radius: 8px;
}

QScrollBar:horizontal {
	background: #191D24;
	height: 10px;
	border-radius: 5px;
}

QScrollBar::handle:horizontal {
	background: #3E4A5E;
	min-width: 24px;
	border-radius: 5px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
	width: 0px;
}

QScrollBar:vertical {
	background: #191D24;
	width: 10px;
	border-radius: 5px;
}

QScrollBar::handle:vertical {
	background: #3E4A5E;
	min-height: 24px;
	border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
	height: 0px;
}</string>
